@startuml
skinparam componentStyle rectangle

package "Blade Runner Server" {
    package "API / Controllers" {
        [GithubApiController]
        [RemoteRepositoryController]
        [MetricsController]
        [InteractivePrController]
        [GlobalExceptionHandler]
    }

    package "Services" {
        [RemoteRepositoryService]
        [MetricsService]
        [PrMetadataService]
        [SonarService]
        [CodeQLService]
        [DiffVisualizerService]
    }

    package "Persistence" {
        [PullRequestMetadataRepository]
        [FileDifMetadataRepository]
        [PrScanResultRepository]
        
        database "H2 Database" {
            [PullRequestMetadata]
            [FileDiffMetadata]
            [LineDiffMetadata]
            [PrScanResult]
        }
    }

    package "Config & Security" {
        [SecurityConfig]
        [ApiKeyFilter]
        [WebSocketConfig]
    }
}

package "External Systems" {
    [GitHub API] <<External>>
    [SonarCloud] <<External>>
    [Blade Runner Worker] <<External>>
}

package "Clients" {
    [Frontend / Web UI]
}

' Relationships
[Frontend / Web UI] --> [API / Controllers] : REST / WebSocket
[API / Controllers] --> [Services]
[Services] --> [Persistence]
[Services] --> [GitHub API]
[Services] --> [SonarCloud]
[MetricsController] ..> [Blade Runner Worker] : Receives results (SARIF, Call Graph)
[RemoteRepositoryService] ..> [Blade Runner Worker] : Triggers Scan

[GithubApiController] --( OAuth2 / API Key )
[SecurityConfig] ..> [ApiKeyFilter]

@enduml
