# Backend public URL
APP_URL=http://localhost:8080

# GitHub OAuth App (required by Spring OAuth2 auto-config)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Personal Access Token for server-side calls
GITHUB_PAT=

# SonarCloud / SonarQube token
SONAR_TOKEN=

# Spring profile: dev | unsecured
SPRING_PROFILES_ACTIVE=dev

# Worker repo that hosts scanner.yaml (the runner workflow)
APP_GITHUB_OWNER=
APP_GITHUB_WORKER_REPO=blade-runner-worker

# SonarCloud project key the scanner pushes to
APP_SONAR_COMPONENT_KEY=
