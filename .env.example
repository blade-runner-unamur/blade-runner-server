# Public URL served by Nginx Proxy Manager (also where the worker posts scan results back)
APP_URL=https://bladerunner.mozzon.net

# Docker network shared with your Nginx Proxy Manager container
PROXY_NETWORK=nginx-network

# GitHub OAuth App (required by Spring OAuth2 auto-config)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Personal Access Token for server-side calls and worker dispatch
GITHUB_PAT=

# Shared secret the worker uses to authenticate its POST /metrics callback
BACKEND_TOKEN=

# SonarCloud / SonarQube token
SONAR_TOKEN=

# GitHub org and worker repo that hosts scanner.yaml
APP_GITHUB_OWNER=blade-runner-unamur
APP_GITHUB_WORKER_REPO=blade-runner-worker

# SonarCloud project key the scanner pushes to
APP_SONAR_COMPONENT_KEY=blade-runner-unamur

# Spring profile: dev | unsecured
SPRING_PROFILES_ACTIVE=unsecured
